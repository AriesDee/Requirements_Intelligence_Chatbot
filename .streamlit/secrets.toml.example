# Rename this file to secrets.toml for local dev, OR paste these values
# directly into Streamlit Community Cloud → App settings → Secrets.
#
# NEVER commit secrets.toml to git — it is listed in .gitignore.

[gcp_service_account]
type = "service_account"
project_id = "gcp-abs-sbt01-psbx-sbx-prj-01"
private_key_id = "PASTE_KEY_ID_HERE"
private_key = "-----BEGIN RSA PRIVATE KEY-----\nPASTE_PRIVATE_KEY_HERE\n-----END RSA PRIVATE KEY-----\n"
client_email = "PASTE_SERVICE_ACCOUNT_EMAIL_HERE"
client_id = "PASTE_CLIENT_ID_HERE"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "PASTE_CLIENT_X509_CERT_URL_HERE"

# Optional overrides (defaults already work for the sandbox project)
# GOOGLE_CLOUD_PROJECT = "gcp-abs-sbt01-psbx-sbx-prj-01"
# GOOGLE_CLOUD_LOCATION = "us-central1"
